# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# NOTE: you do NOT need credentials for the official Meta Ads MCP server. It
# authenticates through Meta Business OAuth in the browser, with no token to
# create or rotate. See docs/meta-ads-mcp.md. The variables below are for the
# things OAuth does not cover.

# --- Meta Ad Library (Phase 4: category monitoring) -------------------------
# A user access token from a Meta app that has passed identity confirmation.
# This is a SEPARATE system from the Ads MCP and does require a token.
# Setup: docs/ad-library-access.md
META_AD_LIBRARY_TOKEN=

# --- Google Ads API (Phase 3, only if you run Google Ads) -------------------
# Skip all of these if Google Ads is not in scope. Setup: docs/google-ads-mcp.md
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# --- ClickUp (optional: post digests and reports into the workspace) --------
CLICKUP_API_TOKEN=
CLICKUP_ADS_LIST_ID=
